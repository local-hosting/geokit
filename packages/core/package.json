  "scripts": {
    "build": "tsup --config config/tsup.config.js && tsc -p config/tsconfig.build.json",
    "dev": "vite --config ../../vite.demo.config.js",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:integration": "vitest run --config config/vitest.integration.config.ts",
    "test:all": "vitest run --config config/vitest.config.ts && vitest run --config config/vitest.integration.config.ts",
    "test:browser": "vitest run --config config/vitest.browser.config.ts",
    "test:demo": "tsx tests/integration/demo-smoke.ts",
    "typecheck": "tsc -p config/tsconfig.json --noEmit",
    "lint": "eslint --config config/eslint.config.mjs . --ext .ts",
    "lint:fix": "eslint --config config/eslint.config.mjs . --ext .ts --fix",
    "format": "prettier --config config/.prettierrc.json --ignore-path config/.prettierignore --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --config config/.prettierrc.json --ignore-path config/.prettierignore --check \"**/*.{ts,json,md}\"",
    "prepare": "husky",
    "prepublishOnly": "yarn build && yarn test",
    "postinstall": "patch-package || true",
    "export:parity-fixtures": "node scripts/export-parity-fixtures.mjs > ../../../geokit-swift/Tests/GeoKitCoreTests/Fixtures/parity-fixtures.json",
    "check:parity-fixtures": "node scripts/check-parity-fixtures.mjs",
    "verify:parity": "bash scripts/verify-parity.sh"
  },
