{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "rootDir": "../src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "customConditions": [
      "source"
    ],
    "paths": {
      "@geokit/ui": [
        "../ui/src/index.ts"
      ],
      "@geokit/ui/*": [
        "../ui/src/*"
      ],
      "@geokit/ui/bootstrap/*": [
        "../ui/src/bootstrap/*"
      ],
      "@geokit/ui/adapters/*": [
        "../ui/src/adapters/*"
      ],
      "@geokit/ui/components/*": [
        "../ui/src/components/*"
      ],
      "@geokit/ui/utils/*": [
        "../ui/src/utils/*"
      ],
      "@geokit/ui/bootstrap/ensure-map-ready": [
        "../ui/src/bootstrap/ensure-map-ready.ts"
      ],
      "@geokit/ui/lifecycle": [
        "../ui/src/lifecycle.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "../src/**/*"
  ],
  "exclude": [
    "../node_modules",
    "../dist",
    "../tests"
  ]
}
