{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "customConditions": ["development"],
    "baseUrl": ".",
    "paths": {
      "@geokit/api": ["../api/src/index.ts"],
      "@geokit/api/*": ["../api/src/*"],
      "geokit/*": ["../core/src/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
