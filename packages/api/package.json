{
  "name": "@geokit/api",
  "version": "0.1.0",
  "description": "Geokit API providers and place taxonomy",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./place-taxonomy": {
      "types": "./src/place-taxonomy.ts",
      "import": "./src/place-taxonomy.ts",
      "default": "./src/place-taxonomy.ts"
    },
    "./registry": {
      "types": "./src/providers/registry.ts",
      "import": "./src/providers/registry.ts",
      "default": "./src/providers/registry.ts"
    },
    "./types": {
      "types": "./src/providers/types.ts",
      "import": "./src/providers/types.ts",
      "default": "./src/providers/types.ts"
    },
    "./types/api-composite": {
      "types": "./src/types/api-composite.ts",
      "import": "./src/types/api-composite.ts",
      "default": "./src/types/api-composite.ts"
    },
    "./types/foursquare-places": {
      "types": "./src/types/foursquare-places.ts",
      "import": "./src/types/foursquare-places.ts",
      "default": "./src/types/foursquare-places.ts"
    },
    "./types/place-taxonomy": {
      "types": "./src/types/place-taxonomy.ts",
      "import": "./src/types/place-taxonomy.ts",
      "default": "./src/types/place-taxonomy.ts"
    },
    "./plugin": {
      "types": "./src/plugin.ts",
      "import": "./src/plugin.ts",
      "default": "./src/plugin.ts"
    },
    "./builtins": {
      "types": "./src/builtins.ts",
      "import": "./src/builtins.ts",
      "default": "./src/builtins.ts"
    },
    "./setup-capability-routers": {
      "types": "./src/setup-capability-routers.ts",
      "import": "./src/setup-capability-routers.ts",
      "default": "./src/setup-capability-routers.ts"
    }
  },
  "scripts": {
    "typecheck": "yarn run -T tsc -p tsconfig.json --noEmit",
    "test": "yarn run -T vitest run"
  },
  "devDependencies": {
    "@geokit/core": "workspace:*",
    "@geokit/plugin-foursquare": "workspace:*",
    "@geokit/plugin-google": "workspace:*",
    "@geokit/plugin-mapbox": "workspace:*",
    "@geokit/plugin-maptiler": "workspace:*",
    "@geokit/plugin-osm": "workspace:*"
  },
  "peerDependencies": {
    "@geokit/core": ">=0.2.33",
    "@geokit/plugin-foursquare": ">=0.1.0",
    "@geokit/plugin-google": ">=0.1.0",
    "@geokit/plugin-mapbox": ">=0.1.0",
    "@geokit/plugin-maptiler": ">=0.1.0",
    "@geokit/plugin-osm": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@geokit/core": {
      "optional": false
    },
    "@geokit/plugin-foursquare": {
      "optional": true
    },
    "@geokit/plugin-google": {
      "optional": true
    },
    "@geokit/plugin-mapbox": {
      "optional": true
    },
    "@geokit/plugin-maptiler": {
      "optional": true
    },
    "@geokit/plugin-osm": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
