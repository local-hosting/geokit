{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "customConditions": [
      "development"
    ],
    "baseUrl": ".",
    "paths": {
      "geokit/*": [
        "../core/src/*"
      ],
      "@geokit/geotypes/geokit": [
        "../geotypes/src/geokit-adapter.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
