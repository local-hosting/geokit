{
  "name": "@geokit/h3",
  "version": "0.1.0",
  "description": "H3 hex grid geometry utilities for Geokit",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./lite": {
      "types": "./src/lite.ts",
      "import": "./src/lite.ts",
      "default": "./src/lite.ts"
    },
    "./cell-to-region-index": {
      "types": "./src/cell/cell-to-region-index.ts",
      "import": "./src/cell/cell-to-region-index.ts",
      "default": "./src/cell/cell-to-region-index.ts"
    }
  },
  "scripts": {
    "typecheck": "yarn run -T tsc -p tsconfig.json --noEmit",
    "test": "yarn run -T vitest run --config vitest.config.ts"
  },
  "peerDependencies": {
    "h3-js": "^4.3.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "h3-js": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
