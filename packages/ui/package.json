{
  "name": "@geokit/ui",
  "version": "0.2.33",
  "description": "Geokit map UI — Web Components, layer controllers, and framework adapters",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "browser": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.js"
    },
    "./core": {
      "source": "./src/core.ts",
      "types": "./dist/esm/core.d.ts",
      "import": "./dist/esm/core.js",
      "require": "./dist/cjs/core.cjs",
      "default": "./dist/esm/core.js"
    },
    "./theme.css": {
      "source": "./src/theme.css",
      "default": "./dist/ui/theme.css"
    },
    "./bootstrap/ensure-map-ready": {
      "source": "./src/bootstrap/ensure-map-ready.ts",
      "types": "./dist/esm/bootstrap/ensure-map-ready.d.ts",
      "import": "./dist/esm/bootstrap/ensure-map-ready.js",
      "require": "./dist/cjs/bootstrap/ensure-map-ready.cjs",
      "default": "./dist/esm/bootstrap/ensure-map-ready.js"
    },
    "./adapters/shared": {
      "source": "./src/adapters/shared/index.ts",
      "types": "./dist/esm/adapters/shared/index.d.ts",
      "import": "./dist/esm/adapters/shared/index.js",
      "require": "./dist/cjs/adapters/shared/index.cjs",
      "default": "./dist/esm/adapters/shared/index.js"
    },
    "./vue": {
      "source": "./src/adapters/vue/index.ts",
      "types": "./dist/esm/adapters/vue/index.d.ts",
      "import": "./dist/esm/adapters/vue/index.js",
      "require": "./dist/cjs/adapters/vue/index.cjs",
      "default": "./dist/esm/adapters/vue/index.js"
    },
    "./react": {
      "source": "./src/adapters/react/index.ts",
      "types": "./dist/esm/adapters/react/index.d.ts",
      "import": "./dist/esm/adapters/react/index.js",
      "require": "./dist/cjs/adapters/react/index.cjs",
      "default": "./dist/esm/adapters/react/index.js"
    },
    "./svelte": {
      "source": "./src/adapters/svelte/index.ts",
