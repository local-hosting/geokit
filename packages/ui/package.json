      "require": "./dist/cjs/utils/boundary-map.cjs",
      "default": "./dist/esm/utils/boundary-map.js"
    },
    "./choropleth-fill-layer": {
      "source": "./src/utils/choropleth-fill-layer.ts",
      "types": "./dist/esm/utils/choropleth-fill-layer.d.ts",
      "import": "./dist/esm/utils/choropleth-fill-layer.js",
      "require": "./dist/cjs/utils/choropleth-fill-layer.cjs",
      "default": "./dist/esm/utils/choropleth-fill-layer.js"
    },
    "./choropleth-fill-paint": {
      "source": "./src/utils/choropleth-fill-paint.ts",
      "types": "./dist/esm/utils/choropleth-fill-paint.d.ts",
      "import": "./dist/esm/utils/choropleth-fill-paint.js",
      "require": "./dist/cjs/utils/choropleth-fill-paint.cjs",
      "default": "./dist/esm/utils/choropleth-fill-paint.js"
    },
    "./geojson-source-options": {
      "source": "./src/utils/geojson-source-options.ts",
      "types": "./dist/esm/utils/geojson-source-options.d.ts",
      "import": "./dist/esm/utils/geojson-source-options.js",
