      "types": "./dist/esm/utils/boundary-outline-preset.d.ts",
      "import": "./dist/esm/utils/boundary-outline-preset.js",
      "require": "./dist/cjs/utils/boundary-outline-preset.cjs",
      "default": "./dist/esm/utils/boundary-outline-preset.js"
    },
    "./elements/isochrone": {
      "source": "./src/components/elements/isochrone/isochrone.ts",
      "types": "./dist/esm/components/elements/isochrone/isochrone.d.ts",
      "import": "./dist/esm/components/elements/isochrone/isochrone.js",
      "default": "./dist/esm/components/elements/isochrone/isochrone.js"
    },
