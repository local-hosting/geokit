      "default": "./dist/esm/shared-points.js"
    },
    "./lazy-popup": {
      "source": "./src/lazy-popup.ts",
      "types": "./dist/esm/lazy-popup.d.ts",
      "import": "./dist/esm/lazy-popup.js",
      "require": "./dist/cjs/lazy-popup.cjs",
      "default": "./dist/esm/lazy-popup.js"
    },
    "./map-facet-filters": {
