      "import": "./dist/esm/components/elements/map-collection/map-collection.js",
      "default": "./dist/esm/components/elements/map-collection/map-collection.js"
    },
    "./elements/popup": {
      "source": "./src/components/elements/popup/popup.ts",
      "types": "./dist/esm/components/elements/popup/popup.d.ts",
      "import": "./dist/esm/components/elements/popup/popup.js",
      "default": "./dist/esm/components/elements/popup/popup.js"
    },
    "./lifecycle": {
      "source": "./src/lifecycle.ts",
      "types": "./dist/esm/lifecycle.d.ts",
      "import": "./dist/esm/lifecycle.js",
      "require": "./dist/cjs/lifecycle.cjs",
      "default": "./dist/esm/lifecycle.js"
    },
    "./dev-proxy/maptiler": {
      "source": "./src/dev-proxy/maptiler-dev-proxy.ts",
      "types": "./dist/esm/dev-proxy/maptiler-dev-proxy.d.ts",
      "import": "./dist/esm/dev-proxy/maptiler-dev-proxy.js",
      "default": "./dist/esm/dev-proxy/maptiler-dev-proxy.js"
    }
  },
  "sideEffects": [
    "*.css",
    "./dist/esm/core.js",
    "./dist/esm/components/elements/*.js",
    "./dist/esm/components/controls/*.js",
    "./dist/cjs/core.cjs",
    "./dist/cjs/components/elements/*.cjs",
    "./dist/cjs/components/controls/*.cjs",
    "./src/core.ts",
    "./src/components/elements/*.ts",
    "./src/components/controls/*.ts"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup --config config/tsup.config.js && tsc -p config/tsconfig.build.json",
    "test": "vitest run --config config/vitest.config.ts",
    "typecheck": "tsc -p config/tsconfig.json --noEmit",
    "lint": "eslint --config config/eslint.config.mjs . --ext .ts"
  },
  "keywords": [
    "geospatial",
    "map",
    "ui",
    "web-components",
    "maplibre",
    "maptiler"
  ],
  "license": "MPL-2.0",
  "packageManager": "yarn@4.18.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "dependencies": {
    "@geokit/core": "workspace:*",
    "@maptiler/sdk": "3.10.2",
    "mapbox-gl": "^3.17.0"
  },
  "peerDependencies": {
    "@geokit/service": ">=0.1.0",
    "react": ">=18.0.0",
    "svelte": ">=4.0.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "@geokit/service": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@geokit/service": "workspace:*",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "happy-dom": "^20.1.0",
    "prettier": "^3.6.2",
    "react": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  }
}
