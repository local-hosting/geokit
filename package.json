{
  "name": "geokit-monorepo",
  "private": true,
  "description": "Geokit monorepo — geospatial SDK and POI taxonomy",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "build": "yarn workspace geokit run build",
    "build:all": "yarn workspaces foreach -Apt run build",
    "dev": "yarn workspace geokit run dev",
    "test": "yarn workspace geokit run test && yarn workspace @geokit/geotypes run test",
    "test:core": "yarn workspace geokit run test",
    "test:geotypes": "yarn workspace @geokit/geotypes run test",
    "typecheck": "yarn workspaces foreach -Apt run typecheck",
    "lint": "yarn workspace geokit run lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
