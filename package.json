    "build:core": "yarn build:core:bundle && yarn build:core:types",
    "build:ui": "cd src/ui && tsup --config config/tsup.config.js && tsc -p config/tsconfig.build.json",
    "test": "yarn test:core && yarn test:crosswalk && yarn validate:exports",
    "pretest": "yarn generate:dev-config",
    "test:core": "vitest run --config src/core/config/vitest.config.ts",
    "test:crosswalk": "vitest run --config config/vitest.crosswalk.config.ts",
    "typecheck": "tsc -p src/core/config/tsconfig.json --noEmit",
    "pretypecheck": "yarn generate:tsconfig-paths",
    "demo": "vite --config vite.demo.config.js",
    "publish:package": "npm publish --registry=https://npm.pkg.github.com --ignore-scripts",
    "build:packages": "yarn build:env && yarn build:service && yarn build:h3 && yarn build:foursquare",
    "build:env": "cd src/env && tsup --config config/tsup.config.js && tsc -p config/tsconfig.build.json",
