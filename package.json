{
  "name": "@twinfile/geokit",
  "version": "0.1.3",
  "description": "A functional, curried geospatial utility toolkit for browser and Node.js",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "browser": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "browser": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./distance": {
      "types": "./dist/esm/distance/index.d.ts",
      "import": "./dist/esm/distance/index.js",
      "require": "./dist/cjs/distance/index.cjs",
      "default": "./dist/esm/distance/index.js"
    },
    "./coordinates": {
      "types": "./dist/esm/coordinates/index.d.ts",
      "import": "./dist/esm/coordinates/index.js",
      "require": "./dist/cjs/coordinates/index.cjs",
      "default": "./dist/esm/coordinates/index.js"
    },
    "./geojson": {
      "types": "./dist/esm/geojson/index.d.ts",
      "import": "./dist/esm/geojson/index.js",
      "require": "./dist/cjs/geojson/index.cjs",
      "default": "./dist/esm/geojson/index.js"
    },
    "./normalize": {
      "types": "./dist/esm/normalize/index.d.ts",
      "import": "./dist/esm/normalize/index.js",
      "require": "./dist/cjs/normalize/index.cjs",
      "default": "./dist/esm/normalize/index.js"
    },
    "./bounds": {
      "types": "./dist/esm/bounds/index.d.ts",
      "import": "./dist/esm/bounds/index.js",
      "require": "./dist/cjs/bounds/index.cjs",
      "default": "./dist/esm/bounds/index.js"
    },
    "./types": {
      "types": "./dist/esm/types/index.d.ts",
      "import": "./dist/esm/types/index.js",
      "require": "./dist/cjs/types/index.cjs",
      "default": "./dist/esm/types/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p config/tsconfig.json && tsc -p config/tsconfig.cjs.json && node scripts/fix-esm-imports.js && node scripts/rename-cjs.js",
    "test": "vitest run --config config/vitest.config.ts --environment node",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:node": "vitest run --config config/vitest.config.ts --environment node",
    "test:browser": "vitest run --config config/vitest.config.ts --environment jsdom",
    "test:all": "yarn test:node && yarn test:browser",
    "typecheck": "tsc -p config/tsconfig.json --noEmit",
    "lint": "eslint --config config/eslint.config.mjs . --ext .ts",
    "lint:fix": "eslint --config config/eslint.config.mjs . --ext .ts --fix",
    "format": "prettier --config config/.prettierrc.json --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --config config/.prettierrc.json --check \"**/*.{ts,json,md}\"",
    "prepare": "husky",
    "prepublishOnly": "yarn build && yarn test",
    "postinstall": "",
    "publish": "npm publish"
  },
  "keywords": [
    "geospatial",
    "geography",
    "coordinates",
    "haversine",
    "distance",
    "geojson",
    "functional",
    "curried",
    "browser",
    "node"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "@twinfile:registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/browser": "^4.0.10",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.2.6",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --config config/.prettierrc.json --write",
      "eslint --config config/eslint.config.mjs --fix"
    ],
    "*.{json,md}": [
      "prettier --config config/.prettierrc.json --write"
    ]
  },
  "peerDependencies": {},
  "peerDependenciesMeta": {},
  "dependencies": {
    "@turf/along": "^7.3.0",
    "@turf/area": "^7.3.0",
    "@turf/bbox": "^7.3.0",
    "@turf/bbox-polygon": "^7.3.0",
    "@turf/bearing": "^7.3.0",
    "@turf/boolean-contains": "^7.3.0",
    "@turf/boolean-point-in-polygon": "^7.3.0",
    "@turf/buffer": "^7.3.0",
    "@turf/center": "^7.3.0",
    "@turf/centroid": "^7.3.0",
    "@turf/convex": "^7.3.0",
    "@turf/destination": "^7.3.0",
    "@turf/helpers": "^7.3.0",
    "@turf/length": "^7.3.0",
    "@turf/line-intersect": "^7.3.0",
    "@turf/midpoint": "^7.3.0",
    "@turf/nearest-point-on-line": "^7.3.0",
    "@turf/simplify": "^7.3.0",
    "@turf/union": "^7.3.1",
    "@types/geojson": "^7946.0.16",
    "h3-js": "^4.3.0",
    "latlon-geohash": "^2.0.0"
  }
}
