    "build:core:types:pre-ui": "cd src/core && NODE_OPTIONS='--max-old-space-size=4096' tsc -p config/tsconfig.build.pre-ui.json",
    "generate:pre-ui-tsconfig-paths": "node scripts/generate-pre-ui-tsconfig-paths.mjs",
    "build:crosswalk": "cd src/crosswalk && tsup --config config/tsup.config.js && NODE_OPTIONS='--max-old-space-size=4096' tsc -p config/tsconfig.build.json && node ../../scripts/copy-crosswalk-generated-declarations.mjs",
