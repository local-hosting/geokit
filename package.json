    "build:h3": "cd src/h3 && tsup --config config/tsup.config.js && tsc -p config/tsconfig.build.json",
    "build:foursquare": "cd src/providers/foursquare && tsup --config config/tsup.config.js && tsc -p config/tsconfig.build.json",
    "normalize:exports": "node scripts/normalize-package-exports.mjs",
    "validate:exports": "node scripts/validate-package-exports.mjs",
    "prepublishOnly": "yarn build && yarn normalize:exports && yarn validate:exports",
    "generate:tsconfig-paths": "node scripts/generate-geokit-tsconfig-paths.mjs",
    "generate:dev-config": "node scripts/generate-dev-config.mjs",
    "build:core:bundle": "node src/core/scripts/check-build-tsconfig.mjs && cd src/core && tsup --config config/tsup.config.js && node ../../scripts/check-no-src-declarations.mjs",
