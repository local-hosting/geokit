{
  "name": "geokit-monorepo",
  "private": true,
  "description": "Geokit monorepo — geospatial SDK and POI taxonomy",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "build": "yarn workspace @geokit/core run build && yarn workspace @geokit/ui run build",
    "build:all": "yarn workspaces foreach -Apt run build",
    "dev": "yarn demo",
    "test": "yarn workspaces foreach -Apt run test",
    "test:core": "yarn workspace @geokit/core run test",
    "test:ui": "yarn workspace @geokit/ui run test",
    "typecheck": "yarn workspaces foreach -Apt run typecheck",
    "lint": "yarn workspace @geokit/core run lint",
    "prepare": "husky",
    "demo": "yarn workspace @geokit/core run dev"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "husky": "^9.1.7",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
