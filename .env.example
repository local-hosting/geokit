# Basemap tiles (MapLibre style + optional self-hosted tile CDN)
GEOKIT_MAP_API_KEY=
# Full style.json URL — overrides built-in MapTiler/Mapbox style names
# GEOKIT_MAP_STYLE_URL=https://tiles.example.com/styles/dark/style.json
# Rewrite MapTiler API and tile CDN hostnames (MapTiler-compatible servers)
# GEOKIT_TILE_API_URL=https://tiles.example.com/
# GEOKIT_TILE_CDN_URL=https://cdn.example.com/

MAPTILER_KEY=
MAPBOX_TOKEN=

# Nearby search (nearby tool)
FOURSQUARE_SERVICE_API_KEY=
FOURSQUARE_API_KEY=

# Optional map MCP host (separate app — not part of geokit)
# MAP_HOST_URL=http://localhost:3002
