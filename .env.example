# Map snapshots (show_map, render_map)
MAPTILER_KEY=
MAPBOX_TOKEN=

# Nearby search (nearby tool) — prefer service key for Places API
FOURSQUARE_SERVICE_API_KEY=
FOURSQUARE_API_KEY=

# Globe CDN — DMA market outlines (Louisville DMA, New York DMA, …)
# Same HS256 secret as mapto.link / apps/fieldwise
GLOBE_CDN_JWT_SECRET=
# Optional: pre-signed bearer token instead of secret
# GLOBE_CDN_JWT=
FW_GLOBE_CDN_URL=https://mapto.link

# Interactive map host (open_map / show_map links)
# MAP_HOST_URL=http://localhost:3002
# GEOKIT_AUTO_MAP_HOST=1 — MCP starts yarn map-host when port is free (default on)
# GEOKIT_AUTO_MAP_HOST=0 — disable auto-start; run yarn map-host yourself
