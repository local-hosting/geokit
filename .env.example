# Basemap tiles (MapLibre style + optional self-hosted tile CDN)
GEOKIT_MAP_API_KEY=
# Full style.json URL — overrides built-in MapTiler/Mapbox style names
# GEOKIT_MAP_STYLE_URL=https://tiles.example.com/styles/dark/style.json
# Rewrite MapTiler API and tile CDN hostnames (MapTiler-compatible servers)
# GEOKIT_TILE_API_URL=https://tiles.example.com/
# GEOKIT_TILE_CDN_URL=https://cdn.example.com/

MAPTILER_KEY=
MAPBOX_TOKEN=

# Optional geo shape CDN (county/DMA/zip boundaries — not basemap tiles)
# GEOKIT_GEO_CDN_URL=https://geo.example.com
# GEOKIT_GEO_CDN_JWT_SECRET=
# GEOKIT_GEO_CDN_JWT=

# Legacy geo CDN env names (still supported)
# GLOBE_CDN_URL=
# GLOBE_CDN_JWT_SECRET=

# Nearby search (nearby tool)
FOURSQUARE_SERVICE_API_KEY=
FOURSQUARE_API_KEY=

# Interactive map host (open_map / show_map links)
# MAP_HOST_URL=http://localhost:3002
# GEOKIT_AUTO_MAP_HOST=1 — MCP starts yarn map-host when port is free (default on)
# GEOKIT_AUTO_MAP_HOST=0 — disable auto-start; run yarn map-host yourself
