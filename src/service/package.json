{
  "name": "@geokit/service",
  "version": "0.1.0",
  "description": "Geokit service registry, routing, and shared HTTP utilities",
  "license": "MPL-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./registry": {
      "types": "./src/services/registry.ts",
      "import": "./src/services/registry.ts",
      "default": "./src/services/registry.ts"
    },
    "./types": {
      "types": "./src/services/types.ts",
      "import": "./src/services/types.ts",
      "default": "./src/services/types.ts"
    },
    "./types/api-composite": {
      "types": "./src/types/api-composite.ts",
      "import": "./src/types/api-composite.ts",
      "default": "./src/types/api-composite.ts"
    },
    "./plugin": {
      "types": "./src/plugin.ts",
      "import": "./src/plugin.ts",
      "default": "./src/plugin.ts"
    },
    "./builtins": {
      "types": "./src/builtins.ts",
      "import": "./src/builtins.ts",
      "default": "./src/builtins.ts"
    },
    "./setup-capability-routers": {
      "types": "./src/setup-capability-routers.ts",
      "import": "./src/setup-capability-routers.ts",
      "default": "./src/setup-capability-routers.ts"
    }
  },
  "scripts": {
    "typecheck": "yarn run -T tsc -p tsconfig.json --noEmit",
    "test": "yarn run -T vitest run --config ../../config/vitest.service.config.ts"
  },
  "devDependencies": {
    "@geokit/core": "workspace:*",
    "@geokit/foursquare": "workspace:*",
    "@geokit/google": "workspace:*",
    "@geokit/mapbox": "workspace:*",
    "@geokit/maptiler": "workspace:*",
    "@geokit/osm": "workspace:*"
  },
  "peerDependencies": {
    "@geokit/core": ">=0.2.33",
    "@geokit/foursquare": ">=0.1.0",
    "@geokit/google": ">=0.1.0",
    "@geokit/mapbox": ">=0.1.0",
    "@geokit/maptiler": ">=0.1.0",
    "@geokit/osm": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@geokit/core": {
      "optional": false
    },
    "@geokit/foursquare": {
      "optional": true
    },
    "@geokit/google": {
      "optional": true
    },
    "@geokit/mapbox": {
      "optional": true
    },
    "@geokit/maptiler": {
      "optional": true
    },
    "@geokit/osm": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twinfile/geokit.git"
  }
}
