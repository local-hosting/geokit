{
  "name": "@local-hosting/geokit-service",
  "version": "0.1.0",
  "description": "Geokit service registry, routing, and shared HTTP utilities",
  "license": "MPL-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./registry": {
      "types": "./dist/esm/services/registry.d.ts",
      "import": "./dist/esm/services/registry.js",
      "default": "./dist/esm/services/registry.js"
    },
    "./types": {
      "types": "./dist/esm/services/types.d.ts",
      "import": "./dist/esm/services/types.js",
      "default": "./dist/esm/services/types.js"
    },
    "./types/api-composite": {
      "types": "./dist/esm/types/api-composite.d.ts",
      "import": "./dist/esm/types/api-composite.js",
      "default": "./dist/esm/types/api-composite.js"
    },
    "./plugin": {
      "types": "./dist/esm/plugin.d.ts",
      "import": "./dist/esm/plugin.js",
      "default": "./dist/esm/plugin.js"
    },
    "./builtins": {
      "types": "./dist/esm/builtins.d.ts",
      "import": "./dist/esm/builtins.js",
      "default": "./dist/esm/builtins.js"
    },
    "./setup-capability-routers": {
      "types": "./dist/esm/setup-capability-routers.d.ts",
      "import": "./dist/esm/setup-capability-routers.js",
      "default": "./dist/esm/setup-capability-routers.js"
    },
    "./place-search": {
      "types": "./dist/esm/search-places-with-geocode-fallback.d.ts",
      "import": "./dist/esm/search-places-with-geocode-fallback.js",
      "default": "./dist/esm/search-places-with-geocode-fallback.js"
    },
    "./geocode-to-place-search": {
      "types": "./dist/esm/geocode-to-place-search.d.ts",
      "import": "./dist/esm/geocode-to-place-search.js",
      "default": "./dist/esm/geocode-to-place-search.js"
    }
  },
  "scripts": {
    "typecheck": "yarn run -T tsc -p tsconfig.json --noEmit",
    "test": "yarn run -T vitest run --config ../../config/vitest.service.config.ts",
    "build": "tsup --config config/tsup.config.js && tsc -p config/tsconfig.build.json"
  },
  "peerDependencies": {
    "@local-hosting/geokit-core": ">=0.2.33",
    "@local-hosting/geokit-foursquare": ">=0.1.0",
    "@local-hosting/geokit-google": ">=0.1.0",
    "@local-hosting/geokit-mapbox": ">=0.1.0",
    "@local-hosting/geokit-maptiler": ">=0.1.0",
    "@local-hosting/geokit-osm": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@local-hosting/geokit-core": {
      "optional": false
    },
    "@local-hosting/geokit-foursquare": {
      "optional": true
    },
    "@local-hosting/geokit-google": {
      "optional": true
    },
    "@local-hosting/geokit-mapbox": {
      "optional": true
    },
    "@local-hosting/geokit-maptiler": {
      "optional": true
    },
    "@local-hosting/geokit-osm": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twinfile/geokit.git"
  }
}
