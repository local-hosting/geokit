{
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./foursquare-places": {
      "types": "./dist/esm/foursquare-places.d.ts",
      "import": "./dist/esm/foursquare-places.js",
      "default": "./dist/esm/foursquare-places.js"
    }
  },
  "scripts": {
    "typecheck": "yarn run -T tsc -p tsconfig.json --noEmit",
    "test": "yarn run -T vitest run --config ../../config/vitest.plugin.config.ts",
    "build": "tsup --config config/tsup.config.js && tsc -p config/tsconfig.build.json"
  },
  "peerDependencies": {
    "@geokit/core": ">=0.2.33",
    "@geokit/service": ">=0.1.0"
  },
  "name": "@geokit/foursquare",
  "description": "Foursquare Places search plugin for geokit"
}
