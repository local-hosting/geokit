/**
 * Backfill missing H3→DMA entries from k-ring neighbors, then refresh derived tables.
 * Run: yarn codegen:h3-dma
 */
import * as fs from 'node:fs';
import * as path from 'node:path';
import { fileURLToPath } from 'node:url';
import { gridDisk } from 'h3-js';
import { H3_R5_TO_ZIPS } from '../generated/us/h3-r5-to-zips.ts';
import { H3_TO_DMA } from '../generated/us/h3-to-dma.ts';

const MODULE_DIR = path.dirname(fileURLToPath(import.meta.url));
const OUT_DIR = path.join(MODULE_DIR, '../generated/us');
const header = '/** Generated by @local-hosting/geokit/crosswalk codegen-h3-dma-gaps — do not edit. */\n\n';
const MAX_K_RING = 4;

function emitConst(name: string, value: unknown): string {
  return `export const ${name} = ${JSON.stringify(value)} as const;\n`;
}

function compactH3CellId(cellId: string): string {
  const normalized = cellId.trim().toLowerCase();
  const compact = normalized.replace(/f+$/i, '');
  return compact || normalized;
}

function expandH3CellId(cellId: string): string {
  const normalized = cellId.trim().toLowerCase();
  if (normalized.length >= 15) return normalized.slice(0, 15);
  return normalized.padEnd(15, 'f');
}

function lookupDmaForH3(
  h3ToDma: Readonly<Record<string, string>>,
  h3Cell: string
): string | undefined {
  const compact = compactH3CellId(h3Cell);
  const direct = h3ToDma[compact];
  if (direct) return direct;
  const full = expandH3CellId(compact);
  for (let k = 1; k <= MAX_K_RING; k++) {
    for (const neighbor of gridDisk(full, k)) {
      const dma = h3ToDma[compactH3CellId(neighbor)];
      if (dma) return dma;
    }
  }
  return undefined;
}

function fillH3ToDmaGaps(
  h3ToDma: Record<string, string>,
  cellUniverse: Iterable<string>
): Record<string, string> {
  const out = { ...h3ToDma };
  let filled = 0;
  for (const cell of cellUniverse) {
    const compact = compactH3CellId(cell);
    if (out[compact]) continue;
    const dma = lookupDmaForH3(out, compact);
    if (!dma) continue;
    out[compact] = dma;
    filled += 1;
  }
  console.log(`fillH3ToDmaGaps: +${filled} cells from k-ring propagation`);
  return out;
}

function buildDmaToZips(
  h3ToDma: Record<string, string>,
  h3ToZips: Record<string, readonly string[]>
): Record<string, string[]> {
  const byDma = new Map<string, Set<string>>();
  for (const [h3, zips] of Object.entries(h3ToZips)) {
    const dma = h3ToDma[compactH3CellId(h3)];
    if (!dma) continue;
    let set = byDma.get(dma);
    if (!set) {
      set = new Set();
      byDma.set(dma, set);
    }
    for (const zip of zips) set.add(zip);
  }
  const out: Record<string, string[]> = {};
  for (const [dma, set] of byDma) out[dma] = [...set].sort();
  return out;
}

const before = Object.keys(H3_TO_DMA).length;
const gapsBefore = Object.keys(H3_R5_TO_ZIPS).filter((cell) => !H3_TO_DMA[compactH3CellId(cell)]).length;
const h3ToDma = fillH3ToDmaGaps({ ...(H3_TO_DMA as Record<string, string>) }, Object.keys(H3_R5_TO_ZIPS));
const after = Object.keys(h3ToDma).length;
const gapsAfter = Object.keys(H3_R5_TO_ZIPS).filter((cell) => !h3ToDma[compactH3CellId(cell)]).length;

fs.writeFileSync(path.join(OUT_DIR, 'h3-to-dma.ts'), header + emitConst('H3_TO_DMA', h3ToDma));

const dmaToZips = buildDmaToZips(h3ToDma, H3_R5_TO_ZIPS as Record<string, readonly string[]>);
fs.writeFileSync(path.join(OUT_DIR, 'dma-to-zips.ts'), header + emitConst('DMA_TO_ZIPS', dmaToZips));

const metaPath = path.join(OUT_DIR, 'meta.ts');
if (fs.existsSync(metaPath)) {
  const metaBody = fs.readFileSync(metaPath, 'utf8');
  const match = metaBody.match(/export const US_CROSSWALK_META = (\{[\s\S]*?\}) as const;/);
  if (match) {
    const meta = JSON.parse(match[1]);
    meta.builtAt = new Date().toISOString();
    meta.h3ToDmaCells = after;
    meta.h3R5Cells = Object.keys(H3_R5_TO_ZIPS).length;
    meta.dmaCount = Object.keys(dmaToZips).length;
    fs.writeFileSync(metaPath, header + emitConst('US_CROSSWALK_META', meta));
  }
}

console.log(
  `h3-to-dma gaps: ${gapsBefore} → ${gapsAfter} (cells ${before} → ${after}, dma-to-zips ${Object.keys(dmaToZips).length})`
);
