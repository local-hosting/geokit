function buildGeohashToDma(
  geohashP8ToZips: Record<string, string[]>,
  zipToH3: Record<string, string>,
  h3ToDma: Record<string, string>
): Record<string, string> {
  const out: Record<string, string> = {};
  for (const [geohash, zips] of Object.entries(geohashP8ToZips)) {
    for (const zip of zips) {
      const h3 = zipToH3[zip] ?? zipToH3[zip.padStart(5, '0')];
      if (!h3) continue;
      const dma = h3ToDma[compactH3CellId(h3)];
      if (dma) {
        out[geohash] = dma;
        break;
      }
    }
  }
  return out;
}

function emitConst(name: string, value: unknown): string {
  return `export const ${name} = ${JSON.stringify(value)} as const;\n`;
}

const header = '/** Generated by @twinfile/geokit codegen-geokit-crosswalk — do not edit. */\n\n';
const geohashP8ToZips = buildGeohashP8ToZips(H3_R5_TO_ZIPS as Record<string, readonly string[]>);
const zipToGeohashP8 = invertZipToGeohash(geohashP8ToZips);
const geohashToDma = buildGeohashToDma(
  geohashP8ToZips,
  ZIP_TO_H3_R5 as Record<string, string>,
  H3_TO_DMA as Record<string, string>
);

fs.writeFileSync(path.join(OUT_DIR, 'geohash-p8-to-zips.ts'), header + emitConst('GEOHASH_P8_TO_ZIPS', geohashP8ToZips));
fs.writeFileSync(path.join(OUT_DIR, 'zip-to-geohash-p8.ts'), header + emitConst('ZIP_TO_GEOHASH_P8', zipToGeohashP8));
fs.writeFileSync(path.join(OUT_DIR, 'geohash-to-dma.ts'), header + emitConst('GEOHASH_TO_DMA', geohashToDma));

const indexPath = path.join(OUT_DIR, 'index.ts');
let indexBody = fs.readFileSync(indexPath, 'utf8');
const extraExports = [
  'export { GEOHASH_TO_DMA } from "./geohash-to-dma";',
  'export { GEOHASH_P8_TO_ZIPS } from "./geohash-p8-to-zips";',
  'export { ZIP_TO_GEOHASH_P8 } from "./zip-to-geohash-p8";',
];
for (const line of extraExports) {
  if (indexBody.includes(line) || indexBody.includes(line.replace('.js', '.js'))) continue;
  const bare = line.replace('.js', '');
  if (indexBody.includes(bare)) continue;
  indexBody += `\n${line}`;
}
fs.writeFileSync(indexPath, indexBody.endsWith('\n') ? indexBody : `${indexBody}\n`);

const meta = {
  builtAt: new Date().toISOString(),
  country: 'us',
  h3ToDmaCells: Object.keys(H3_TO_DMA).length,
  h3R5Cells: Object.keys(H3_R5_TO_ZIPS).length,
  geohashToDmaCells: Object.keys(geohashToDma).length,
  geohashP8Cells: Object.keys(geohashP8ToZips).length,
  zipCount: Object.keys(ZIP_TO_H3_R5).length,
  dmaCount: new Set(Object.values(geohashToDma)).size,
};
fs.writeFileSync(path.join(OUT_DIR, 'meta.ts'), header + emitConst('US_CROSSWALK_META', meta));

console.log(
  `geohash tables: ${Object.keys(geohashP8ToZips).length} cells, ${Object.keys(geohashToDma).length} dma mappings`
