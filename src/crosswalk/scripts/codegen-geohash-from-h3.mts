/**
 * Derive geohash p8 crosswalk tables from generated H3 tables.
 * Run: node --experimental-strip-types scripts/codegen-geohash-from-h3.mts
 */
import * as fs from 'node:fs';
import * as path from 'node:path';
import { fileURLToPath } from 'node:url';
import { cellToBoundary, cellToLatLng } from 'h3-js';
import { H3_R5_TO_ZIPS } from '../generated/us/h3-r5-to-zips.ts';
import { H3_TO_DMA } from '../generated/us/h3-to-dma.ts';
import { ZIP_TO_H3_R5 } from '../generated/us/zip-to-h3-r5.ts';

const GEOHASH_ZIP_INDEX_PRECISION = 8;
const BASE32 = '0123456789bcdefghjkmnpqrstuvwxyz';
const MODULE_DIR = path.dirname(fileURLToPath(import.meta.url));
const OUT_DIR = path.join(MODULE_DIR, '../generated/us');

function compactH3CellId(cellId: string): string {
  const normalized = cellId.trim().toLowerCase();
  const compact = normalized.replace(/f+$/i, '');
  return compact || normalized;
}

function expandH3CellId(cellId: string): string {
  const normalized = cellId.trim().toLowerCase();
  if (normalized.length >= 15) return normalized.slice(0, 15);
  return normalized.padEnd(15, 'f');
}

function encodeGeohash(lat: number, lon: number, precision = GEOHASH_ZIP_INDEX_PRECISION): string {
  let idx = 0;
  let bit = 0;
  let evenBit = true;
  let geohash = '';
  let latMin = -90;
  let latMax = 90;
  let lonMin = -180;
  let lonMax = 180;
  while (geohash.length < precision) {
    if (evenBit) {
      const mid = (lonMin + lonMax) / 2;
      if (lon >= mid) {
        idx = (idx << 1) + 1;
        lonMin = mid;
      } else {
        idx <<= 1;
        lonMax = mid;
      }
    } else {
      const mid = (latMin + latMax) / 2;
      if (lat >= mid) {
        idx = (idx << 1) + 1;
        latMin = mid;
      } else {
        idx <<= 1;
        latMax = mid;
      }
    }
    evenBit = !evenBit;
    if (++bit === 5) {
      geohash += BASE32[idx];
      bit = 0;
      idx = 0;
    }
  }
  return geohash;
}

function h3CellSamplePoints(h3Cell: string): Array<[number, number]> {
  const cellId = expandH3CellId(h3Cell);
  const points: Array<[number, number]> = [cellToLatLng(cellId)];
  for (const [lat, lng] of cellToBoundary(cellId, true)) {
    points.push([lat, lng]);
  }
  return points;
}

import { buildGeohashNativeFromH3 } from '../src/h3/geohash-native.js';

function buildGeohashP8ToZips(h3ToZips: Record<string, readonly string[]>): Record<string, string[]> {
  return buildGeohashNativeFromH3(h3ToZips as Record<string, string[]>, GEOHASH_ZIP_INDEX_PRECISION);
}

