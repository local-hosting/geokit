{
  "name": "@twinfile/geokit-h3",
  "version": "0.1.0",
  "description": "H3 hex grid geometry utilities for Geokit",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./lite": {
      "types": "./dist/esm/lite.d.ts",
      "import": "./dist/esm/lite.js",
      "default": "./dist/esm/lite.js"
    },
    "./cell-to-region-index": {
      "types": "./dist/esm/cell/cell-to-region-index.d.ts",
      "import": "./dist/esm/cell/cell-to-region-index.js",
      "default": "./dist/esm/cell/cell-to-region-index.js"
    }
  },
  "scripts": {
    "check:src": "node scripts/check-no-src-declarations.mjs",
    "typecheck": "yarn check:src && yarn run -T tsc -p tsconfig.json --noEmit",
    "test": "yarn check:src && yarn run -T vitest run --config vitest.config.ts",
    "build": "tsup --config config/tsup.config.js && tsc -p config/tsconfig.build.json"
  },
  "peerDependencies": {
    "h3-js": "^4.3.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "h3-js": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twinfile/geokit.git"
  }
}
