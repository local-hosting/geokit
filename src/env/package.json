{
  "name": "@local-hosting/geokit-env",
  "version": "0.1.0",
  "description": "Geokit environment key resolution and bootstrap (no geo dependencies)",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./service-keys": {
      "types": "./dist/esm/service-keys.d.ts",
      "import": "./dist/esm/service-keys.js",
      "default": "./dist/esm/service-keys.js"
    },
    "./map-credentials": {
      "types": "./dist/esm/map-credentials.d.ts",
      "import": "./dist/esm/map-credentials.js",
      "default": "./dist/esm/map-credentials.js"
    },
    "./primitives": {
      "types": "./dist/esm/primitives.d.ts",
      "import": "./dist/esm/primitives.js",
      "default": "./dist/esm/primitives.js"
    },
    "./bootstrap": {
      "types": "./dist/esm/bootstrap.d.ts",
      "import": "./dist/esm/bootstrap.js",
      "default": "./dist/esm/bootstrap.js"
    }
  },
  "scripts": {
    "typecheck": "yarn run -T tsc -p tsconfig.json --noEmit",
    "test": "yarn run -T vitest run --config vitest.config.ts",
    "build": "tsup --config config/tsup.config.js && tsc -p config/tsconfig.build.json"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local-hosting/geokit.git"
  }
}
